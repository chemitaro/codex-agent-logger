#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
VENV_PYTHON="${REPO_ROOT}/.venv/bin/python"

if [[ -x "${VENV_PYTHON}" ]]; then
  exec "${VENV_PYTHON}" -m codex_logger.cli "$@"
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "error: ${VENV_PYTHON} is not executable and uv is not installed" >&2
  exit 127
fi

exec uv run --project "${REPO_ROOT}" --frozen python -m codex_logger.cli "$@"
